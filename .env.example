# Copy to .env (git-ignored) and fill in locally. Never commit .env or real credential values.

# --- API / dashboard ---
ANTROUTE_CONFIG=/app/config/config.yaml
# Verified real-data bundle served read-only; empty = real data shown as "Unavailable".
ANTROUTE_ARTIFACTS_DIR=
# Host folder mounted at /app/bundle by docker-compose.yml.
ANTROUTE_BUNDLE_HOST_DIR=./artifacts/bundle
# Exact origins allowed to call the API from a separately hosted dashboard, comma-separated:
# https://host[:port], no path, no trailing slash, no wildcard (http only for localhost).
ANTROUTE_CORS_ORIGINS=
ANTROUTE_MAX_JOBS=200
ANTROUTE_MAX_VOYAGES=100
# Largest scenarios x grid cells per request (200 scenarios on the 10 km grid peak at about 1.3 GB).
ANTROUTE_MAX_SCENARIO_CELLS=6000000
# Computations running at once, in requests or background jobs; peak memory is about
# 0.2 GB + ANTROUTE_MAX_COMPUTE x the largest request.
ANTROUTE_MAX_COMPUTE=2
# Largest request body in bytes (the biggest valid request is about 3 KB).
ANTROUTE_MAX_BODY_BYTES=65536
ANTROUTE_LOG_LEVEL=INFO
# Commit of the deployed code, shown by /versions (on Render, RENDER_GIT_COMMIT is used when this is empty).
ANTROUTE_GIT_COMMIT=

# --- Dashboard build for separate hosting (frontend/build.mjs, e.g. Vercel) ---
# Public origin of the API; the only value the build writes into the page.
ANTROUTE_API_BASE=

# --- Reproducing the frozen demo (backend/worker only) ---
ANTROUTE_DATA_ROOT=

# --- Data-service credentials (ingestion workers only; never the API or the frontend) ---
CDSAPI_URL=
CDSAPI_KEY=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
